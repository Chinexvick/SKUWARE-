# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skuware?schema=public"

# JWT signing secret for access/refresh tokens — generate with: openssl rand -base64 48
AUTH_JWT_SECRET="replace-with-a-long-random-secret"

# Cookie settings
COOKIE_DOMAIN="localhost"
NODE_ENV="development"

# App
APP_URL="http://localhost:3000"

# AI features (student tutor, teacher/parent assistants, question generation).
# Without this set, AI endpoints return a clear "not configured" message
# instead of a fabricated response.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
